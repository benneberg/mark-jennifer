    // ─── Groq API (streaming + multimodal) ───────────────────
    function buildMessagesForApi(projectMessages) {
      const skillsBlock = state.skills.length
        ? '\n\nAvailable skills:\n' + state.skills.map(s => `- ${s.name}: ${s.description}\n  Instructions: ${s.prompt}`).join('\n')
        : '';
      const systemContent = (state.systemPrompt || defaultSystem) + skillsBlock;

      const apiMessages = [{ role: 'system', content: systemContent }];
      for (const m of projectMessages) {
        if (m.role === 'system') continue;
        if (m.images?.length && VISION_MODELS.includes(state.model)) {
          const content = [];
          m.images.forEach(dataUrl => {
            content.push({ type: 'image_url', image_url: { url: dataUrl } });
          });
          content.push({ type: 'text', text: m.content || '(see image)' });
          apiMessages.push({ role: m.role, content });
        } else {
          let text = m.content;
          if (m.images?.length) text = (text || '') + '\n[User attached image(s); switch to Qwen 3.8 27B for vision.]';
          apiMessages.push({ role: m.role, content: text });
        }
      }
      return apiMessages;
    }

    async function callGroqStream(projectMessages, onDelta) {
      if (!state.apiKey) throw new Error('Add your Groq API key in Settings.');
      const payload = {
        model: state.model,
        temperature: state.temperature,
        messages: buildMessagesForApi(projectMessages),
        max_tokens: 4096,
        stream: true
      };
      abortController = new AbortController();
      const res = await fetch(`${GROQ_BASE}/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${state.apiKey}`
        },
        body: JSON.stringify(payload),
        signal: abortController.signal
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error?.message || res.statusText || 'API error');
      }
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let full = '';
      let buffer = '';
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const lines = buffer.split('\n');
        buffer = lines.pop() || '';
        for (const line of lines) {
          const trimmed = line.trim();
          if (!trimmed || !trimmed.startsWith('data:')) continue;
          const data = trimmed.slice(5).trim();
          if (data === '[DONE]') continue;
          try {
            const json = JSON.parse(data);
            const delta = json.choices?.[0]?.delta?.content || '';
            if (delta) {
              full += delta;
              onDelta(full, delta);
            }
          } catch (_) {}
        }
      }
      return full;
    }

    async function callGroqOnce(projectMessages) {
      if (!state.apiKey) throw new Error('Add your Groq API key in Settings.');
      const payload = {
        model: state.model,
        temperature: state.temperature,
        messages: buildMessagesForApi(projectMessages),
        max_tokens: 4096,
        stream: false
      };
      const res = await fetch(`${GROQ_BASE}/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${state.apiKey}`
        },
        body: JSON.stringify(payload)
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        throw new Error(err.error?.message || res.statusText || 'API error');
      }
      const data = await res.json();
      return data.choices?.[0]?.message?.content || '';
    }

    async function sendMessage(text) {
      if ((!text.trim() && !state.attachments.length) || isGenerating) return;
      const p = ensureProject();
      const images = state.attachments.filter(a => a.dataUrl).map(a => a.dataUrl);
      const userMsg = {
        role: 'user',
        content: text.trim() || (images.length ? 'Please review the attached image(s).' : ''),
        images: images.length ? images : undefined,
        ts: Date.now()
      };
      p.messages.push(userMsg);
      p.updatedAt = Date.now();
      if (images.length && !VISION_MODELS.includes(state.model)) {
        toast('Tip: switch to Qwen 3.8 27B in Settings for image understanding');
      }
      renderMessages();
      document.getElementById('chatInput').value = '';
      autoResize(document.getElementById('chatInput'));
      updateSendBtn();
      clearAttachments();
      saveState();
      updateProjectBanner();

      isGenerating = true;
      document.getElementById('headerStatus').textContent = 'Thinking…';
      showTyping(true);

      try {
        let reply;
        if (state.stream) {
          const bubble = startStreamBubble();
          reply = await callGroqStream(p.messages, (full) => {
            bubble.textContent = stripArtifactMarkers(full) || full;
            bubble.classList.add('stream-cursor');
            document.getElementById('chatMessages').scrollTop = document.getElementById('chatMessages').scrollHeight;
          });
          bubble.classList.remove('stream-cursor');
          document.getElementById('streamMsg')?.remove();
        } else {
          reply = await callGroqOnce(p.messages);
        }

        const artifacts = extractArtifacts(reply);
        const displayText = stripArtifactMarkers(reply) || reply;
        p.messages.push({ role: 'assistant', content: displayText, ts: Date.now() });
        if (artifacts.length) {
          p.artifacts.push(...artifacts);
          if (p.name === 'Untitled campaign') {
            const plan = artifacts.find(a => a.type === 'plan');
            if (plan) p.name = plan.title.slice(0, 60);
          }
          renderArtifactSelect();
          toast(`${artifacts.length} artifact${artifacts.length > 1 ? 's' : ''} → Showroom`);
        }
        p.updatedAt = Date.now();
        saveState();
        renderMessages();
        updateProjectBanner();
        renderProjects();
      } catch (err) {
        if (err.name === 'AbortError') {
          toast('Cancelled');
        } else {
          p.messages.push({
            role: 'assistant',
            content: `I couldn't reach the model: ${err.message}\n\nCheck your API key and model in Settings.`,
            ts: Date.now()
          });
          renderMessages();
          toast(err.message);
        }
      } finally {
        isGenerating = false;
        showTyping(false);
        document.getElementById('streamMsg')?.remove();
        updateProjectBanner();
        abortController = null;
      }
    }

    // ─── Attachments (images as data URLs) ───────────────────
    function clearAttachments() {
      state.attachments = [];
      document.getElementById('attachPreview').innerHTML = '';
    }
    function renderAttachments() {
      const prev = document.getElementById('attachPreview');
      prev.innerHTML = state.attachments.map((a, i) => `
        <div class="attach-chip">
          ${a.dataUrl ? `<img src="${a.dataUrl}" alt="" />` : ''}
          <span>${escapeHtml(a.name)}</span>
          <button data-rm="${i}" aria-label="Remove">×</button>
        </div>
      `).join('');
    }
    function readFileAsDataURL(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(reader.result);
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }
    async function addAttachments(files) {
      for (const f of files) {
        if (!f.type.startsWith('image/')) continue;
        if (f.size > 4 * 1024 * 1024) {
          toast(`${f.name} too large (max 4MB)`);
          continue;
        }
        try {
          const dataUrl = await readFileAsDataURL(f);
          state.attachments.push({ name: f.name, type: f.type, dataUrl });
        } catch (_) {
          toast('Could not read ' + f.name);
        }
      }
      renderAttachments();
      updateSendBtn();
    }

    // ─── Voice ───────────────────────────────────────────────
    function initSpeech() {
      const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SR) return;
      recognition = new SR();
      recognition.continuous = false;
      recognition.interimResults = false;
      recognition.lang = navigator.language || 'en-US';
      recognition.onresult = (e) => {
        const t = e.results[0][0].transcript;
        const input = document.getElementById('chatInput');
        input.value = (input.value + ' ' + t).trim();
        autoResize(input);
        updateSendBtn();
      };
      recognition.onend = () => document.getElementById('btnMic').classList.remove('recording');
      recognition.onerror = () => {
        document.getElementById('btnMic').classList.remove('recording');
        toast('Voice input failed');
      };
    }

    // ─── Export ──────────────────────────────────────────────
    function getExportPack() {
      const p = activeProject();
      if (!p) return null;
      return {
        exportedAt: new Date().toISOString(),
        project: { id: p.id, name: p.name, goal: p.goal, status: p.status },
        conversation: p.messages.map(m => ({ role: m.role, content: m.content, ts: m.ts })),
        artifacts: p.artifacts,
        skills: state.skills.map(s => s.name)
      };
    }
    function downloadBlob(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      a.click();
      URL.revokeObjectURL(url);
    }
    function exportJson() {
      const pack = getExportPack();
      if (!pack) { toast('No project'); return; }
      const name = (pack.project.name || 'campaign').replace(/\s+/g, '-').toLowerCase();
      downloadBlob(new Blob([JSON.stringify(pack, null, 2)], { type: 'application/json' }), `lena-${name}.json`);
      toast('JSON downloaded');
    }
    function exportMarkdown() {
      const pack = getExportPack();
      if (!pack) { toast('No project'); return; }
      let md = `# ${pack.project.name}\n\n**Status:** ${pack.project.status}\n**Exported:** ${pack.exportedAt}\n\n`;
      if (pack.project.goal) md += `## Goal\n${pack.project.goal}\n\n`;
      md += `## Artifacts\n\n`;
      pack.artifacts.forEach(a => {
        md += `### ${a.title} (${a.type}) — ${a.status}\n\n${a.content}\n\n---\n\n`;
      });
      md += `## Conversation\n\n`;
      pack.conversation.forEach(m => {
        md += `**${m.role === 'assistant' ? 'Lena' : 'You'}:** ${m.content}\n\n`;
      });
      const name = (pack.project.name || 'campaign').replace(/\s+/g, '-').toLowerCase();
      downloadBlob(new Blob([md], { type: 'text/markdown' }), `lena-${name}.md`);
      toast('Markdown downloaded');
    }
    function exportHtml() {
      const pack = getExportPack();
      if (!pack) { toast('No project'); return; }
      const arts = pack.artifacts.map(a => `
        <section style="margin-bottom:2rem;padding:1.25rem;border:1px solid #e2e8f0;border-radius:12px;">
          <h2 style="margin:0 0 .5rem;font-size:1.15rem;">${escapeHtml(a.title)}</h2>
          <p style="margin:0 0 1rem;font-size:.85rem;color:#64748b;">${a.type} · ${a.status}</p>
          <div style="white-space:pre-wrap;line-height:1.6;">${escapeHtml(a.content)}</div>
        </section>`).join('');
      const html = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>${escapeHtml(pack.project.name)}</title>
        <style>body{font-family:system-ui,sans-serif;max-width:720px;margin:2rem auto;padding:0 1rem;color:#0f172a;line-height:1.5}
        h1{font-size:1.5rem} .meta{color:#64748b;font-size:.9rem;margin-bottom:2rem}</style></head>
        <body><h1>${escapeHtml(pack.project.name)}</h1>
        <p class="meta">Exported ${escapeHtml(pack.exportedAt)} · ${pack.artifacts.length} artifacts</p>
        ${pack.project.goal ? `<p><strong>Goal:</strong> ${escapeHtml(pack.project.goal)}</p>` : ''}
        ${arts}
        <hr/><h2>Conversation</h2>
        ${pack.conversation.map(m => `<p><strong>${m.role === 'assistant' ? 'Lena' : 'You'}:</strong> ${escapeHtml(m.content)}</p>`).join('')}
        </body></html>`;
      const name = (pack.project.name || 'campaign').replace(/\s+/g, '-').toLowerCase();
      downloadBlob(new Blob([html], { type: 'text/html' }), `lena-${name}.html`);
      toast('HTML report downloaded');
    }

