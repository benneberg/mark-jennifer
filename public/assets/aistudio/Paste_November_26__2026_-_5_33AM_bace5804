      const input = document.getElementById('chatInput');
      input.addEventListener('input', () => { autoResize(input); updateSendBtn(); });
      input.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          sendMessage(input.value);
        }
      });
      document.getElementById('btnSend').addEventListener('click', () => sendMessage(input.value));
      document.getElementById('suggestions').addEventListener('click', e => {
        const chip = e.target.closest('.chip');
        if (chip) sendMessage(chip.dataset.prompt);
      });

      document.getElementById('btnAttach').addEventListener('click', () => document.getElementById('fileInput').click());
      document.getElementById('fileInput').addEventListener('change', e => {
        if (e.target.files?.length) addAttachments([...e.target.files]);
        e.target.value = '';
      });
      document.getElementById('attachPreview').addEventListener('click', e => {
        const btn = e.target.closest('[data-rm]');
        if (btn) {
          state.attachments.splice(+btn.dataset.rm, 1);
          renderAttachments();
          updateSendBtn();
        }
      });

      document.getElementById('btnMic').addEventListener('click', () => {
        if (!recognition) { toast('Speech not supported in this browser'); return; }
        const btn = document.getElementById('btnMic');
        if (btn.classList.contains('recording')) { recognition.stop(); return; }
        btn.classList.add('recording');
        recognition.start();
      });

      // Showroom
      document.getElementById('artifactSelect').addEventListener('change', () => {
        if (editingArtifactId) {
          exitArtifactEditMode();
        }
        updatePreview();
      });
      document.getElementById('btnCopyArtifact').addEventListener('click', () => {
        const p = activeProject();
        const art = p?.artifacts.find(a => a.id === document.getElementById('artifactSelect').value);
        if (art) navigator.clipboard.writeText(art.content).then(() => toast('Copied')).catch(() => toast('Copy failed'));
      });
      document.getElementById('btnInlineEdit').addEventListener('click', () => {
        const p = activeProject();
        const art = p?.artifacts.find(a => a.id === document.getElementById('artifactSelect').value);
        if (art) enterArtifactEditMode(art);
      });
      document.getElementById('btnAskLena').addEventListener('click', () => {
        const p = activeProject();
        const art = p?.artifacts.find(a => a.id === document.getElementById('artifactSelect').value);
        if (!art) return;
        if (editingArtifactId) exitArtifactEditMode();
        document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));
        document.querySelector('[data-tab="chat"]').classList.add('active');
        document.getElementById('tabChat').classList.add('active');
        input.value = `Please revise the artifact "${art.title}" (${art.type}). Changes I want: `;
        autoResize(input);
        updateSendBtn();
        input.focus();
      });
      document.getElementById('btnAcceptArtifact').addEventListener('click', () => {
        const p = activeProject();
        const art = p?.artifacts.find(a => a.id === document.getElementById('artifactSelect').value);
        if (art) {
          art.status = 'ready';
          p.updatedAt = Date.now();
          saveState();
          renderArtifactSelect();
          toast('Accepted');
        }
      });
      document.getElementById('btnSaveArtifact').addEventListener('click', saveArtifactEdit);
      document.getElementById('btnCancelEdit').addEventListener('click', () => {
        exitArtifactEditMode();
        updatePreview();
      });

      document.getElementById('btnExport').addEventListener('click', () => {
        document.getElementById('exportModal').classList.add('open');
      });
      document.getElementById('btnCloseExport').addEventListener('click', () => {
        document.getElementById('exportModal').classList.remove('open');
      });
      document.getElementById('btnExportJson').addEventListener('click', exportJson);
      document.getElementById('btnExportHtml').addEventListener('click', exportHtml);
      document.getElementById('btnExportMd').addEventListener('click', exportMarkdown);

      ['skillModal', 'projectModal', 'exportModal'].forEach(id => {
        document.getElementById(id).addEventListener('click', e => {
          if (e.target === e.currentTarget) e.currentTarget.classList.remove('open');
        });
      });
    }

    // ─── Init ────────────────────────────────────────────────
    loadState();
    initLenaEyeTracker();
    bindEvents();
    initSpeech();
    renderMessages();
    renderSkills();
    renderArtifactSelect();
    renderProjects();
    updateProjectBanner();
    syncSettingsUI();
    updateSendBtn();
  </script>
</body>
</html>