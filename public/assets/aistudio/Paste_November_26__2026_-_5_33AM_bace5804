  <div class="toast" id="toast"></div>

  <script>
    const STORAGE_KEY = 'lena_campaign_v2';
    const GROQ_BASE = 'https://api.groq.com/openai/v1';
    const VISION_MODELS = ['qwen/qwen3.8-27b'];

    const defaultSkills = [
      { id: 'skill_social', name: 'Social media posts', description: 'Platform-ready posts for Instagram, Facebook, LinkedIn, TikTok.', prompt: 'Write engaging social posts. Include captions, hashtags, and suggested visuals. Format clearly per platform.' },
      { id: 'skill_email', name: 'Email sequence', description: 'Multi-email nurture or promo sequences with subject lines.', prompt: 'Create a short email sequence (3–5 emails). Include subject lines, preview text, and body.' },
      { id: 'skill_ads', name: 'Ad copy', description: 'Paid ads — headlines, primary text, CTAs.', prompt: 'Write ad variants: headlines, primary text, CTAs. Provide 3 options where useful.' },
      { id: 'skill_landing', name: 'Landing page copy', description: 'Hero, benefits, FAQ, CTA sections.', prompt: 'Draft landing page sections: hero, benefits, social proof placeholders, FAQ, CTA.' },
      { id: 'skill_calendar', name: 'Content calendar', description: 'Schedule posts and sends across channels.', prompt: 'Build a practical content calendar. Use lines like: DATE | CHANNEL | ASSET | NOTES so it can be parsed into a calendar view. Cover the full campaign window.' }
    ];

    const defaultSystem = `You are Lena, a friendly expert campaign strategist and content creator.
You help small businesses plan marketing campaigns, produce content and assets, and organize delivery.

Personality: warm, clear, proactive, practical. Ask focused follow-up questions. Prefer concrete plans.

When the user accepts a plan:
1. Confirm project name and goals.
2. Outline a short project plan (phases, channels, timeline).
3. Use relevant skills to produce concrete artifacts.
4. Present artifacts so the user can review them in the Showroom.
5. Invite edits or acceptance. When ready, offer export.

When producing an artifact, wrap content in:
[[ARTIFACT:type|title]]
...content...
[[/ARTIFACT]]
Types: plan, social, email, ad, landing, calendar, other.

For calendar artifacts, use structured lines: YYYY-MM-DD | Channel | Asset type | Notes
so the app can render a calendar view.

Do not invent live posting. Focus on drafts the user can use.`;

    let state = {
      apiKey: '',
      model: 'openai/gpt-oss-20b',
      temperature: 0.7,
      systemPrompt: '',
      stream: true,
      theme: 'light',
      skills: [...defaultSkills],
      projects: [],
      activeProjectId: null,
      // transient
      attachments: [] // { name, type, dataUrl }
    };

    let editingSkillId = null;
    let isGenerating = false;
    let recognition = null;
    let abortController = null;
    let editingArtifactId = null; // inline edit mode

    // ─── Active project helpers ──────────────────────────────
    function activeProject() {
      return state.projects.find(p => p.id === state.activeProjectId) || null;
    }
    function ensureProject() {
      let p = activeProject();
      if (!p) {
        p = {
          id: 'proj_' + Date.now(),
          name: 'Untitled campaign',
          goal: '',
          status: 'In progress',
          messages: [],
          artifacts: [],
          createdAt: Date.now(),
          updatedAt: Date.now()
        };
        state.projects.unshift(p);
        state.activeProjectId = p.id;
      }
      return p;
    }

    // ─── Persistence ─────────────────────────────────────────
    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const saved = JSON.parse(raw);
          state = { ...state, ...saved, attachments: [] };
        }
        // migrate v1 if present
        const v1 = localStorage.getItem('lena_campaign_v1');
        if (v1 && state.projects.length === 0) {
          try {
            const old = JSON.parse(v1);
            if (old.messages?.length || old.artifacts?.length) {
              const p = {
                id: 'proj_migrated',
                name: old.project?.name || 'Migrated campaign',
                goal: '',
                status: old.project?.status || 'In progress',
                messages: old.messages || [],
                artifacts: old.artifacts || [],
                createdAt: Date.now(),
                updatedAt: Date.now()
              };
              state.projects = [p];
              state.activeProjectId = p.id;
              if (old.apiKey) state.apiKey = old.apiKey;
              if (old.model) state.model = old.model;
              if (old.skills?.length) state.skills = old.skills;
            }
          } catch (_) {}
        }
      } catch (e) { console.warn(e); }
      applyTheme(state.theme || 'light');
    }

    function saveState() {
      try {
        const { attachments, ...rest } = state;
        localStorage.setItem(STORAGE_KEY, JSON.stringify(rest));
      } catch (e) { console.warn(e); }
    }

    // ─── Theme ───────────────────────────────────────────────
    function applyTheme(theme) {
      state.theme = theme;
      document.documentElement.setAttribute('data-theme', theme === 'dark' ? 'dark' : 'light');
      document.getElementById('themeColor').content = theme === 'dark' ? '#111110' : '#F4EFE4';
      document.getElementById('iconSun').classList.toggle('hidden', theme === 'dark');
      document.getElementById('iconMoon').classList.toggle('hidden', theme !== 'dark');
      const t = document.getElementById('toggleDark');
      if (t) {
        t.classList.toggle('on', theme === 'dark');
        t.setAttribute('aria-checked', theme === 'dark');
      }
    }

    // ─── Interactive Gaze-Tracking Eye Emblem ────────────────
    function initLenaEyeTracker() {
      const reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let idleTimer = null;
      let nudgePhase = 0;

      const setPupilOffset = (dx, dy) => {
        document.querySelectorAll('[data-eye-pupil]').forEach(pupil => {
          if (reducedMotion) {
            pupil.style.transform = 'translate3d(0px, 0px, 0px)';
            return;
          }
          const isLarge = pupil.closest('.welcome');
          const scale = isLarge ? 1.55 : 1;
          pupil.style.transform = `translate3d(${(dx * scale).toFixed(2)}px, ${(dy * scale).toFixed(2)}px, 0px)`;
        });
      };

      const resetIdleTimer = () => {
        clearTimeout(idleTimer);
        idleTimer = setTimeout(() => setPupilOffset(0, 0), 6500);
      };

      const lookAtPoint = (x, y) => {
        const badge = document.getElementById('lenaEyeBadge');
        if (!badge) return;
        const rect = badge.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height / 2;
        const angle = Math.atan2(y - cy, x - cx);
        const maxOffset = 4.5;
        const dist = Math.min(maxOffset, Math.hypot(x - cx, y - cy) / 90);
        setPupilOffset(Math.cos(angle) * dist, Math.sin(angle) * dist);
        resetIdleTimer();
      };

      const lookAtElement = (el) => {
        if (!el || typeof el.getBoundingClientRect !== 'function') return;
        const r = el.getBoundingClientRect();
        nudgePhase = (nudgePhase + 1) % 4;
        const caretBias = (nudgePhase - 1.5) * 18;
        lookAtPoint(r.left + Math.min(r.width * 0.65, 60 + Math.abs(caretBias)), r.top + r.height / 2);
      };

      document.addEventListener('pointerdown', (e) => lookAtPoint(e.clientX, e.clientY), { passive: true });
      document.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'mouse') lookAtPoint(e.clientX, e.clientY);
      }, { passive: true });
      document.addEventListener('focusin', (e) => lookAtElement(e.target), true);
      document.addEventListener('keydown', () => {
        const active = document.activeElement;
        if (active && (active.tagName === 'INPUT' || active.tagName === 'TEXTAREA')) {
          lookAtElement(active);
        } else {
          const badge = document.getElementById('lenaEyeBadge');
          if (!badge) return;
          const r = badge.getBoundingClientRect();
          nudgePhase = (nudgePhase + 1) % 6;
          lookAtPoint(r.left + 80 + Math.cos(nudgePhase) * 40, r.top + 120 + Math.sin(nudgePhase) * 30);
        }
      });
      document.addEventListener('scroll', () => {
        const badge = document.getElementById('lenaEyeBadge');
        if (!badge) return;
        const r = badge.getBoundingClientRect();
        nudgePhase = (nudgePhase + 1) % 6;
        lookAtPoint(r.left + 60, r.top + 140 + Math.sin(nudgePhase) * 25);
      }, { passive: true, capture: true });
    }

    // ─── UI helpers ──────────────────────────────────────────
    function toast(msg, ms = 2400) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.classList.add('show');
      clearTimeout(el._t);
      el._t = setTimeout(() => el.classList.remove('show'), ms);
    }
    function autoResize(ta) {
      ta.style.height = 'auto';
      ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
    }
    function formatTime(ts) {
      return new Date(ts || Date.now()).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    function formatDate(ts) {
      return new Date(ts || Date.now()).toLocaleDateString([], { month: 'short', day: 'numeric' });
    }
    function escapeHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    function simpleMarkdown(text) {
      return escapeHtml(text)
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.+?)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
    }

    // ─── Chat rendering ──────────────────────────────────────
    function renderMessages() {
      const container = document.getElementById('chatMessages');
      const welcome = document.getElementById('welcome');
      const p = activeProject();
      const messages = p?.messages || [];
      if (messages.length === 0) {
        container.innerHTML = '';
        container.appendChild(welcome);
        welcome.classList.remove('hidden');
        document.getElementById('suggestions').classList.remove('hidden');
        return;
      }
      welcome.classList.add('hidden');
      document.getElementById('suggestions').classList.add('hidden');
      container.innerHTML = messages.map(m => {
        if (m.role === 'system') return '';
        const cls = m.role === 'user' ? 'user' : 'assistant';
        let imgs = '';
        if (m.images?.length) {
          imgs = `<div class="msg-images">${m.images.map(src => `<img src="${src}" alt="attachment" />`).join('')}</div>`;
        }
        return `<div class="msg ${cls}">
          ${imgs}
          <div class="msg-bubble">${simpleMarkdown(m.content)}</div>
          <div class="msg-meta">${m.role === 'assistant' ? 'Lena' : 'You'} · ${formatTime(m.ts)}</div>
        </div>`;
      }).join('');
      container.scrollTop = container.scrollHeight;
    }

    function showTyping(show) {
      const container = document.getElementById('chatMessages');
      let el = document.getElementById('typing');
      if (show) {
        if (!el) {
          el = document.createElement('div');
          el.id = 'typing';
          el.className = 'msg assistant';
          el.innerHTML = `<div class="typing-indicator"><span></span><span></span><span></span></div>`;
          container.appendChild(el);
        }
        container.scrollTop = container.scrollHeight;
      } else if (el) el.remove();
    }

    function startStreamBubble() {
      showTyping(false);
      const container = document.getElementById('chatMessages');
      const el = document.createElement('div');
      el.id = 'streamMsg';
      el.className = 'msg assistant';
      el.innerHTML = `<div class="msg-bubble stream-cursor"></div><div class="msg-meta">Lena · …</div>`;
      container.appendChild(el);
      container.scrollTop = container.scrollHeight;
      return el.querySelector('.msg-bubble');
    }

    // ─── Artifacts ───────────────────────────────────────────
    function extractArtifacts(text) {
      const re = /\[\[ARTIFACT:([^|\]]+)\|([^\]]+)\]\]([\s\S]*?)\[\[\/ARTIFACT\]\]/g;
      const found = [];
      let match;
      while ((match = re.exec(text)) !== null) {
        found.push({
          id: 'art_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
          type: match[1].trim().toLowerCase(),
          title: match[2].trim(),
          content: match[3].trim(),
          status: 'draft',
          createdAt: Date.now()
        });
      }
      return found;
    }
    function stripArtifactMarkers(text) {
      return text.replace(/\[\[ARTIFACT:[^\]]+\]\]/g, '').replace(/\[\[\/ARTIFACT\]\]/g, '').trim();
    }

    function parseCalendar(content) {
      const lines = content.split('\n').map(l => l.trim()).filter(Boolean);
      const items = [];
      for (const line of lines) {
        const parts = line.split('|').map(p => p.trim());
        if (parts.length >= 3 && /^\d{4}-\d{2}-\d{2}/.test(parts[0])) {
          items.push({ date: parts[0], channel: parts[1], asset: parts[2], notes: parts[3] || '' });
        }
      }
      return items;
    }

    function renderCalendar(items) {
      if (!items.length) return '';
      const byDate = {};
      items.forEach(i => {
        if (!byDate[i.date]) byDate[i.date] = [];
        byDate[i.date].push(i);
      });
      const dates = Object.keys(byDate).sort();
      return `<div class="cal-grid">${dates.map(d => `
        <div class="cal-day">
          <div class="cal-day-date">${d}</div>
          ${byDate[d].map(i => `
            <div class="cal-item">
              <span class="cal-channel">${escapeHtml(i.channel)}</span>
              ${escapeHtml(i.asset)}${i.notes ? ' · ' + escapeHtml(i.notes) : ''}
            </div>
          `).join('')}
        </div>
      `).join('')}</div>`;
    }

    function renderArtifactSelect() {
      const sel = document.getElementById('artifactSelect');
      const p = activeProject();
      const arts = p?.artifacts || [];
      const badge = document.getElementById('artifactBadge');
      if (arts.length) {
        badge.textContent = arts.length;
        badge.classList.remove('hidden');
      } else badge.classList.add('hidden');

      if (!arts.length) {
        sel.innerHTML = '<option value="">No artifacts yet</option>';
        setShowroomButtonsEnabled(false);
        exitArtifactEditMode();
        document.getElementById('showroomPreview').innerHTML = `<div class="preview-empty">
          <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <div>Artifacts from Lena appear here.</div>
        </div>`;
        return;
      }
      sel.innerHTML = arts.map(a =>
        `<option value="${a.id}">${escapeHtml(a.title)} (${a.type}) — ${a.status}</option>`
      ).join('');
      if (editingArtifactId && arts.some(a => a.id === editingArtifactId)) {
        sel.value = editingArtifactId;
      } else if (!arts.some(a => a.id === sel.value)) {
        sel.value = arts[arts.length - 1].id;
      }
      updatePreview();
    }

    function setShowroomButtonsEnabled(has, art) {
      document.getElementById('btnCopyArtifact').disabled = !has;
      document.getElementById('btnInlineEdit').disabled = !has;
      document.getElementById('btnAskLena').disabled = !has;
      document.getElementById('btnAcceptArtifact').disabled = !has || art?.status === 'ready';
    }

    function setShowroomMode(edit) {
      document.getElementById('showroomActionsView').classList.toggle('hidden', edit);
      document.getElementById('showroomActionsEdit').classList.toggle('hidden', !edit);
      document.getElementById('artifactSelect').disabled = edit;
    }

    function exitArtifactEditMode() {
      editingArtifactId = null;
      setShowroomMode(false);
    }

    function enterArtifactEditMode(art) {
      if (!art) return;
      editingArtifactId = art.id;
      setShowroomMode(true);
      updatePreview();
      const area = document.getElementById('artifactEditArea');
      if (area) {
        area.focus();
        area.setSelectionRange(area.value.length, area.value.length);
      }
    }

    function saveArtifactEdit() {
      const p = activeProject();
      if (!p || !editingArtifactId) return;
      const art = p.artifacts.find(a => a.id === editingArtifactId);
      if (!art) return;
      const titleEl = document.getElementById('artifactEditTitle');
      const area = document.getElementById('artifactEditArea');
      const newTitle = (titleEl?.value || '').trim();
      const newContent = area?.value ?? '';
      if (!newTitle) {
        toast('Title is required');
        titleEl?.focus();
        return;
      }
      art.title = newTitle;
      art.content = newContent;
      if (art.status === 'ready') art.status = 'draft';
      art.updatedAt = Date.now();
      p.updatedAt = Date.now();
      exitArtifactEditMode();
      saveState();
      renderArtifactSelect();
      updateProjectBanner();
      toast('Artifact saved');
    }

    function updatePreview() {
      const id = document.getElementById('artifactSelect').value;
      const preview = document.getElementById('showroomPreview');
      const p = activeProject();
      const art = p?.artifacts.find(a => a.id === id);
      const has = !!art;
      const isEditing = has && editingArtifactId === art.id;

      if (!isEditing) {
        setShowroomButtonsEnabled(has, art);
        setShowroomMode(false);
      }

      if (!art) {
        exitArtifactEditMode();
        preview.innerHTML = `<div class="preview-empty"><div>Select an artifact.</div></div>`;
        return;
      }

      if (isEditing) {
        preview.innerHTML = `<div class="artifact-card">
          <p class="edit-hint">Editing · changes save locally. Status resets to draft if it was accepted.</p>
          <input type="text" class="artifact-edit-title" id="artifactEditTitle" value="${escapeHtml(art.title)}" maxlength="120" />
          <div class="meta" style="margin-bottom:10px">
            <span class="status-badge draft">editing</span>
            <span>${escapeHtml(art.type)}</span>
          </div>
          <textarea class="artifact-edit-area" id="artifactEditArea" spellcheck="true">${escapeHtml(art.content)}</textarea>
          <div class="artifact-edit-actions">
            <button class="btn btn-primary" id="btnSaveArtifactInline">Save</button>
            <button class="btn btn-secondary" id="btnCancelEditInline">Cancel</button>
          </div>
        </div>`;
        document.getElementById('btnSaveArtifactInline')?.addEventListener('click', saveArtifactEdit);
        document.getElementById('btnCancelEditInline')?.addEventListener('click', () => {
          exitArtifactEditMode();
          updatePreview();
        });
        const area = document.getElementById('artifactEditArea');
        area?.addEventListener('keydown', (e) => {
          if ((e.metaKey || e.ctrlKey) && e.key === 's') {
            e.preventDefault();
            saveArtifactEdit();
          }
          if (e.key === 'Escape') {
            e.preventDefault();
            exitArtifactEditMode();
            updatePreview();
          }
        });
        return;
      }

      const statusClass = art.status === 'ready' ? 'ready' : art.status === 'scheduled' ? 'scheduled' : 'draft';
      let bodyHtml = simpleMarkdown(art.content);
      let calToggle = '';
      if (art.type === 'calendar') {
        const items = parseCalendar(art.content);
        if (items.length) {
          calToggle = `<div class="view-toggle">
            <button class="btn btn-secondary active" data-view="cal">Calendar</button>
            <button class="btn btn-secondary" data-view="text">Text</button>
          </div>
          <div id="calView">${renderCalendar(items)}</div>
          <div id="textView" class="artifact-body hidden">${bodyHtml}</div>`;
          bodyHtml = '';
        }
      }
      const updated = art.updatedAt ? ` · edited ${formatTime(art.updatedAt)}` : '';
      preview.innerHTML = `<div class="artifact-card">
        <h3>${escapeHtml(art.title)}</h3>
        <div class="meta">
          <span class="status-badge ${statusClass}">${art.status}</span>
          <span>${escapeHtml(art.type)}</span>
          <span>${formatTime(art.createdAt)}${updated}</span>
        </div>
        ${calToggle}
        <div class="artifact-body">${bodyHtml}</div>
      </div>`;

      preview.querySelectorAll('[data-view]').forEach(btn => {
        btn.addEventListener('click', () => {
          preview.querySelectorAll('[data-view]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const isCal = btn.dataset.view === 'cal';
          document.getElementById('calView')?.classList.toggle('hidden', !isCal);
          document.getElementById('textView')?.classList.toggle('hidden', isCal);
        });
      });
    }

    // ─── Projects list ───────────────────────────────────────
    function renderProjects() {
      const list = document.getElementById('projectsList');
      if (!state.projects.length) {
        list.innerHTML = `<div class="preview-empty" style="grid-column:1/-1;"><div>No projects yet.<br/>Chat with Lena or create one.</div></div>`;
        return;
      }
      list.innerHTML = state.projects.map(p => `
